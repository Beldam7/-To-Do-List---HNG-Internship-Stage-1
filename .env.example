# ─── Supabase ──────────────────────────────────────────────
# These are pre-populated in the Bolt environment.
# When deploying elsewhere, fill them in from your Supabase project settings.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── OpenAI ────────────────────────────────────────────────
# This is a SERVER-SIDE secret used by the Supabase edge function.
# Do NOT prefix with VITE_ — it must never be exposed in the browser.
# Set it as a Supabase edge function secret (see README for instructions).
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Override the OpenAI model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o
